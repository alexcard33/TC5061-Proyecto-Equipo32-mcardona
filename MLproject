name: mibici-equipo32

# Entorno declarado: mismas versiones fijas que requirements.txt.
python_env: python_env.yaml

entry_points:
  # Ingesta reproducible: data/raw -> data/processed + manifiesto (data_version).
  #   periodo: referencia (ene-dic 2025, entrenamiento) -> data/manifest.json
  #            actual (ene-oct 2026, monitoreo de drift y A/B) -> data/manifest_actual.json
  ingest:
    parameters:
      periodo: {type: string, default: referencia}
    command: "python -m mibici.dataset --periodo {periodo}"

  # Entrena y registra en MLflow un modelo de una pregunta.
  #   question:    p1 (regresión), p2 (clasificación) o p3 (clustering).
  #   model:       nombre del modelo de la pregunta; "default" usa MODELO_DEFAULT de config.py.
  #   params:      hiperparámetros como clave=valor separados por comas (p. ej.
  #                learning_rate=0.05,max_iter=350); "none" usa solo los de config.py.
  #                Se evita JSON porque en Windows mlflow run lo pasa por cmd y rompe las comillas.
  #   run_name:    nombre del run; "auto" usa el definido en config.py.
  train:
    parameters:
      question: string
      model: {type: string, default: default}
      params: {type: string, default: none}
      run_name: {type: string, default: auto}
    command: "python -m mibici.modeling.train --question {question} --model {model} --params {params} --run-name {run_name}"

  # Registra en el Model Registry el modelo elegido de cada pregunta (REGISTRO_MODELOS de
  # config.py), copia su linaje y asigna los aliases champion/challenger.
  register:
    parameters:
      question: {type: string, default: all}
    command: "python -m mibici.modeling.register --question {question}"

  # Versión 2 de P1 (Entregable 8): mismo modelo reentrenado con ene 2025 - jun 2026.
  # Deja el run p1_v2_reentrenado; después `register -P question=p1` lo registra como
  # nueva versión de mibici-equipo32-p1-demanda con el alias challenger.
  retrain:
    parameters:
      model: {type: string, default: poisson}
    command: "python -m mibici.modeling.p1_reentrenamiento --model {model}"

  # Descarga del Model Registry el modelo que sirve la API (por defecto P1 @champion) a
  # models/serving/<pregunta>/ con model_info.json, para empaquetarlo en el contenedor.
  export:
    parameters:
      question: {type: string, default: p1}
      alias: {type: string, default: champion}
    command: "python -m mibici.modeling.export_model --question {question} --alias {alias}"
