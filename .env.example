# Plantilla de variables de entorno del proyecto MiBici (Equipo 32).
# Copiar a .env (que está en .gitignore) y completar SOLO en tu máquina:
#   cp .env.example .env
# Nunca subas el archivo .env ni pegues credenciales en el código o en notebooks.

# Servidor de tracking de MLflow (por defecto, el local de `make mlflow-ui`).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Solo si se usa un servidor de MLflow con autenticación (MLflow las lee directamente).
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Solo si los artefactos se guardan en S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Puertos publicados en la máquina local.
API_PORT=8000
MLFLOW_PORT=5000

# De dónde carga la API el modelo: "local" (empaquetado en la imagen) o "registry"
# (Model Registry del MLflow que levanta Compose). MODEL_VERSION vacío = usa el alias.
MODEL_SOURCE=local
MODEL_NAME=mibici-equipo32-p1-demanda
MODEL_ALIAS=champion
MODEL_VERSION=

# Procesos de uvicorn y límites de recursos de cada contenedor.
API_WORKERS=1
API_CPUS=2.0
API_MEMORY=2g
MLFLOW_CPUS=1.0
MLFLOW_MEMORY=1g

# Versión del servidor de MLflow y nombre de la imagen de la API.
MLFLOW_VERSION=3.17.2
API_IMAGE=mibici-api:1.0
