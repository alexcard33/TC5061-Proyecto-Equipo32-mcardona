# Plantilla de variables de entorno del proyecto MiBici (Equipo 32).
# Copiar a .env (que está en .gitignore) y completar SOLO en tu máquina:
#   cp .env.example .env
# Nunca subas el archivo .env ni pegues credenciales en el código o en notebooks.

# Servidor de tracking de MLflow (por defecto, el local de `make mlflow-ui`).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Solo si se usa un servidor de MLflow con autenticación (MLflow las lee directamente).
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Solo si los artefactos se guardan en S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
